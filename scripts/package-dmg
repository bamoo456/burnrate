#!/usr/bin/env sh
set -eu

# Package Burnrate as a macOS .dmg (and the bundled .app it wraps).
#
# `cargo tauri build` enables the custom-protocol feature, embeds the built
# dist/ assets, and stamps the app with icons/icon.icns + an Info.plist, so the
# packaged app shows the real Burnrate icon in the Dock -- unlike the bare
# `cargo build --release` binary, which macOS draws with a generic icon when
# Preferences makes it Dock-visible.
#
# DMG bundling only runs on macOS. Extra args are forwarded to `cargo tauri
# build` (e.g. `package-dmg --target universal-apple-darwin`).
#
# Set APPLE_SIGNING_IDENTITY to code-sign the app with a stable identity. That
# matters because macOS binds a keychain "Always Allow" grant to the requesting
# app's code signature: an unsigned binary changes identity every build, so the
# grant never persists and the app re-prompts on every launch. A Developer
# ID-signed install gets a stable signature, so "Always Allow" sticks.

os="$(uname -s)"
if [ "$os" != "Darwin" ]; then
  echo "package-dmg: .dmg bundles are only produced on macOS (got $os)" >&2
  exit 1
fi

# The Tauri CLI comes either from the Nix devshell (cargo-tauri) or from
# `npm install` (@tauri-apps/cli) -- the README build path uses the latter.
if command -v cargo-tauri >/dev/null 2>&1; then
  tauri="cargo tauri"
elif [ -x node_modules/.bin/tauri ]; then
  tauri="node_modules/.bin/tauri"
else
  echo "package-dmg: no Tauri CLI found; run 'npm install' (or enter 'nix develop')." >&2
  exit 1
fi

if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
  echo "package-dmg: signing with APPLE_SIGNING_IDENTITY=\"$APPLE_SIGNING_IDENTITY\""
  $tauri build --bundles dmg "$@"
else
  echo "package-dmg: building UNSIGNED (--no-sign)." >&2
  echo "  An unsigned app re-prompts for keychain access on every launch." >&2
  hint="$(security find-identity -v -p codesigning 2>/dev/null \
    | sed -nE 's/^[[:space:]]*[0-9]+\)[[:space:]]+[0-9A-F]+[[:space:]]+"(Developer ID Application:.*)"$/\1/p' \
    | head -1)"
  if [ -n "$hint" ]; then
    echo "  To make 'Always Allow' persist, re-run signed:" >&2
    echo "    APPLE_SIGNING_IDENTITY=\"$hint\" package-dmg" >&2
  fi
  $tauri build --no-sign --bundles dmg "$@"
fi

dmg="$(find target -path '*/bundle/dmg/*.dmg' -type f 2>/dev/null | sort | tail -1)"
if [ -n "$dmg" ]; then
  echo "package-dmg: built $dmg"
else
  echo "package-dmg: build finished but no .dmg was found under target/**/bundle/dmg" >&2
  exit 1
fi
